# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — keep the example committed
.env*
!.env.example

# CMS database
/data/*.db
/data/*.db-journal
/data/*.db-wal
/data/*.db-shm
*.db
*.db-journal

# Admin uploads (keep folder via .gitkeep)
/public/uploads/**
!/public/uploads/.gitkeep
!/public/uploads/projects/
!/public/uploads/projects/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
