# Admin login — set these on Hostinger environment variables too.
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=change-this-to-a-strong-password

# Long random string used to sign the admin session cookie (32+ characters).
SESSION_SECRET=generate-a-long-random-string

# SQLite path is relative to prisma/schema.prisma and resolves to ./data/cms.db
DATABASE_URL="file:../data/cms.db"
